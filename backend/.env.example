# ChatBI Backend Environment Configuration
# 复制此文件为 .env 并填入实际配置

# ===== AI Model Configuration =====
# 阿里云 DashScope API 配置（兼容模式）
# 获取 API Key: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-api-key-here
ALIYUN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 旧配置（保留兼容性，会自动使用上面的值）
MODEL_TYPE=local
QWEN_API_KEY=${DASHSCOPE_API_KEY}
QWEN_MODEL_NAME=${DASHSCOPE_MODEL}

# ===== Database Configuration =====
# 本机直接 uvicorn：DB_HOST=127.0.0.1。仅在 docker-compose 容器内后端连库时用 mysql。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=chatbi

# 业务口语「N财月」是否按自然年 N 月理解，并在分析中提示术语与 FM 财期区别（true/false）
CAI_MONTH_COLLOQUIAL_MEANS_NATURAL_MONTH=true

# ===== Application Settings =====
LOG_LEVEL=INFO
DEBUG=false

# 加密密钥（用于密码加密，请生成自己的密钥）
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here
