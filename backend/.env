# ChatBI Backend Environment Configuration

# ===== AI Model Configuration =====
# 阿里云 DashScope API 配置（兼容模式）
DASHSCOPE_API_KEY=sk-399d0eb35c494883afdc3ca41e2ce214
ALIYUN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 旧配置（保留兼容性）
MODEL_TYPE=local
QWEN_API_KEY=${DASHSCOPE_API_KEY}
QWEN_MODEL_NAME=${DASHSCOPE_MODEL}

# ===== 本地 AI 模型（内网 Qwen3.5，用于数据分析）=====
OPENAI_LOCAL_BASE_URL=http://10.136.49.200:11539/v1
OPENAI_LOCAL_API_KEY=none
OPENAI_LOCAL_MODEL=Qwen3.5-35B-A3B

# ===== Database Configuration =====
# 本机直接运行 uvicorn 时，连接宿主机映射端口
# 若使用根目录 docker-compose.yml 的 MySQL，请使用 127.0.0.1:3307
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345678
DB_NAME=chatbi

# ===== SQL Server ODBC Configuration =====
ODBC_DRIVER=ODBC Driver 18 for SQL Server
ODBC_ENCRYPT=yes
# 生产建议 no（校验证书链）；自签名证书可临时设为 yes
ODBC_TRUST_SERVER_CERTIFICATE=yes
# 如证书中的主机名与连接地址不同，可指定证书主机名（CN/SAN）
ODBC_HOSTNAME_IN_CERTIFICATE=

# ===== Application Settings =====
LOG_LEVEL=INFO
DEBUG=false
ENCRYPTION_KEY=2BqHJZfMHY2PRUSMuZAChIAq__aefHYPLOCQif8cFgo=

# ===== Retrieval Tuning (normal / expanded) =====
# normal: 首轮召回（偏保守，控制上下文长度）
RETRIEVAL_NORMAL_MAX_TERMS=30
RETRIEVAL_NORMAL_MAX_LOGICS=20
RETRIEVAL_NORMAL_MAX_EVENTS=10
RETRIEVAL_NORMAL_TABLE_KEEP=30
RETRIEVAL_NORMAL_GLOBAL_KEEP=10
RETRIEVAL_NORMAL_DICTIONARY_KEEP=30

# expanded: 失败重试触发的扩召回（偏激进，降低漏召回）
RETRIEVAL_EXPANDED_MAX_TERMS=80
RETRIEVAL_EXPANDED_MAX_LOGICS=50
RETRIEVAL_EXPANDED_MAX_EVENTS=20
RETRIEVAL_EXPANDED_TABLE_KEEP=60
RETRIEVAL_EXPANDED_GLOBAL_KEEP=20
RETRIEVAL_EXPANDED_DICTIONARY_KEEP=60